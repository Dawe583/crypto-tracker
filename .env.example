# Copy to .env and fill in. Never commit .env.
# chmod 600 .env on the Raspberry Pi.

# RPC endpoints (WebSocket recommended for production; Alchemy or Infura)
BASE_RPC_HTTP=https://mainnet.base.org
BASE_RPC_WS=
ETH_RPC_HTTP=https://eth.llamarpc.com
ETH_RPC_WS=

# Explorer API keys (optional, enables source-verification checks)
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=

# Alerts: Telegram and/or generic webhook. Without them, alerts go to stdout and logs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# Whale and pool thresholds
WHALE_MIN_USD=50000
MIN_LIQUIDITY_USD=20000
MAX_BUY_TAX_PCT=10
MAX_SELL_TAX_PCT=10

# Gold RWA monitor
GOLD_SPOT_URL=https://api.gold-api.com/price/XAU
GOLD_POLL_MS=60000
GOLD_ALERT_PCT=0.5
GOLD_MAJOR_PCT=1.5
BASE_PAXG_ADDRESS=
BASE_XAUT_ADDRESS=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
