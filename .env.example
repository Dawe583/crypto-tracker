# Leave unset for the Supabase-backed paper engine. Set only for an external HTTPS engine.
# Set this in the Vercel project's environment settings to an existing HTTPS engine origin.
# ENGINE_API_ORIGIN=https://your-existing-engine.example
# Copy to .env and fill in. Never commit .env.
# chmod 600 .env on the Raspberry Pi.

# RPC endpoints (WebSocket recommended for production; Alchemy or Infura)
BASE_RPC_HTTP=https://base.drpc.org
BASE_RPC_WS=
ETH_RPC_HTTP=https://eth.drpc.org
ETH_RPC_WS=

# Explorer API keys (optional, enables source-verification checks)
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=

# Alerts: Telegram and/or generic webhook. Without them, alerts go to stdout and logs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# Whale and pool thresholds
WHALE_MIN_USD=50000
MIN_LIQUIDITY_USD=20000
MAX_BUY_TAX_PCT=10
MAX_SELL_TAX_PCT=10

# Gold RWA monitor
GOLD_SPOT_URL=https://api.gold-api.com/price/XAU
GOLD_POLL_MS=60000
GOLD_ALERT_PCT=0.5
GOLD_MAJOR_PCT=1.5
BASE_PAXG_ADDRESS=
BASE_XAUT_ADDRESS=


# Paper trading engine (simulated fills only; no real orders)
ENGINE_ENABLED=true
ENGINE_START_USD=10000
ENGINE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT
ENGINE_INTERVAL=1m
ENGINE_POLL_MS=30000
ENGINE_FEE_PCT=0.1
ENGINE_MAX_POSITION_USD=500
ENGINE_MAX_TOTAL_USD=3000
ENGINE_MAX_OPEN_POSITIONS=8
ENGINE_DAILY_LOSS_PCT=5
ENGINE_MIN_CONFIDENCE=0.5
ENGINE_COOLDOWN_MIN=60

# OpenTerminal JSON API (served by the tracker process)
API_ENABLED=true
# 127.0.0.1 is the safe default. Set 0.0.0.0 only with a strong API_TOKEN for LAN access.
API_HOST=127.0.0.1
API_PORT=8787
# Strongly recommended if the Pi is reachable beyond localhost: openssl rand -hex 32
# The engine kill control stays disabled while this is empty.
API_TOKEN=
# Extra browser origins for CORS, comma-separated (openterminal-ashen.vercel.app and localhost are built in)
API_CORS_ORIGINS=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
